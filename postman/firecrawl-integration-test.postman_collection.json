                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response is successful', () => pm.expect(pm.response.json().success).to.be.true);",
                  "const d = pm.response.json().data || {};",
                  "pm.test('markdown is present', () => pm.expect(d.markdown).to.be.a('string').and.not.empty);"
                ]
              }
            }
          ],
          "description": "Same URL with onlyMainContent:true - drops nav and boilerplate, which is what you want before an LLM prompt."
        },
        {
          "name": "Start batch scrape",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v2/batch/scrape",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v2",
                "batch",
                "scrape"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"urls\": [\n    \"https://example.com\"\n  ],\n  \"formats\": [\n    \"markdown\"\n  ]\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response is successful', () => pm.expect(pm.response.json().success).to.be.true);",
                  "const d = pm.response.json();",
                  "pm.test('a batch id is returned', () => pm.expect(d.id).to.be.a('string').and.not.empty);",
                  "pm.test('no URLs were rejected', () => pm.expect(d.invalidURLs || []).to.have.lengthOf(0));",
                  "pm.collectionVariables.set('batchId', d.id);"
                ]
              }
            }
          ],
          "description": "Async submit: returns an id and a status URL rather than results. The next request polls it."
        },
        {
          "name": "Check batch scrape status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v2/batch/scrape/{{batchId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v2",
                "batch",
                "scrape",
                "{{batchId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response is successful', () => pm.expect(pm.response.json().success).to.be.true);",
                  "const STATUS_URL = pm.variables.replaceIn('{{baseUrl}}/v2/batch/scrape/{{batchId}}');",
                  "const TERMINAL = ['completed', 'failed', 'cancelled'];",
                  "const deadline = Date.now() + 120000;",
                  "const finish = d => {",
                  "  pm.test('batch reached a terminal status', () => pm.expect(d.status).to.be.oneOf(TERMINAL));",
                  "  pm.test('batch completed successfully', () => pm.expect(d.status).to.eql('completed'));",
                  "  pm.test('all URLs were processed', () => pm.expect(d.completed).to.eql(d.total));",
                  "  pm.test('results carry the scraped markdown', () => {",
                  "    const results = d.data || [];",
                  "    pm.expect(results.length).to.be.above(0);",
                  "    pm.expect(results[0].markdown).to.be.a('string').and.not.empty;",
                  "  });",
                  "};",
                  "const poll = () => {",
                  "  pm.sendRequest({ url: STATUS_URL, method: 'GET' }, (err, res) => {",
                  "    if (err) return finish({ status: 'failed', completed: 0, total: 0, data: [] });",
                  "    const d = res.json();",
                  "    if (TERMINAL.includes(d.status) || Date.now() > deadline) return finish(d);",
                  "    setTimeout(poll, 2000);",
                  "  });",
                  "};",
                  "poll();"
                ]
              }
            }
          ],
          "description": "Polls the status URL until it settles. Needs {{batchId}} from the previous request, so run the folder in order."
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "crawlId",
      "value": ""
    },
    {
      "key": "batchId",
      "value": ""
    }
  ]
