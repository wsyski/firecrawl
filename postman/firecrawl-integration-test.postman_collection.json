        {
          "name": "Ask Jev directly (OpenCode Zen)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{typesafeApiKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"state\": \"Buy cheap followers and watch videos now\",\n  \"model\": \"{{jevModel}}\",\n  \"questions\": {\n    \"explicit\": {\n      \"type\": \"noul\",\n      \"instructions\": \"Is this adult content?\"\n    }\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{typesafeUrl}}/v1/systemone",
              "host": [
                "{{typesafeUrl}}"
              ],
              "path": [
                "v1",
                "systemone"
              ]
            },
            "description": "Hits Jev through OpenCode Zen directly (not through Firecrawl) to confirm Zen is reachable, the key is accepted and which model answered. This is the same call apps/api/src/lib/typesafe.ts makes, so it separates a Jev or key problem from a Firecrawl problem.\n\nEdit `state` to move it along the scale: text here is deliberately benign, so `noul` should come back well under the 0.3 threshold in apps/api/src/search/safe-search.ts. The behavioural half - that an explicit result is actually dropped from /v2/search - is covered by the \"Search Safe Filter\" folder."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Jev is a fork addition and Firecrawl runs without it, so a missing key is",
                  "// not a Firecrawl failure. The Postman cloud runner deliberately has no Zen",
                  "// credential, where a hard 401 would report a problem that is not there.",
                  "const key = (pm.variables.replaceIn('{{typesafeApiKey}}') || '').trim();",
                  "if (!key) {",
                  "  console.warn('typesafeApiKey is empty; skipping. postman/run.sh supplies it from .env.prod.');",
                  "  pm.execution.skipRequest();",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "",
                  "const body = pm.response.json();",
                  "pm.test('Response answers the question we asked', () => {",
                  "  pm.expect(body).to.have.property('answers');",
                  "  pm.expect(body.answers).to.have.property('explicit');",
                  "  pm.expect(body.answers.explicit).to.have.property('noul');",
                  "});",
                  "",
                  "const noul = body.answers && body.answers.explicit && body.answers.explicit.noul;",
                  "pm.test('Score is a probability', () => {",
                  "  pm.expect(noul, 'answers.explicit.noul was ' + JSON.stringify(noul)).to.be.a('number');",
                  "  pm.expect(noul).to.be.within(0, 1);",
                  "});",
                  "",
                  "pm.test('The configured model is the one that answered', () => {",
                  "  pm.expect(body.model, 'response said model ' + JSON.stringify(body.model))",
                  "    .to.eql(pm.variables.replaceIn('{{jevModel}}'));",
                  "});",
                  "",
                  "pm.test('Benign text scored below the explicit threshold', () => {",
                  "  // Mirrors EXPLICIT_THRESHOLD in apps/api/src/search/safe-search.ts.",
                  "  pm.expect(noul, 'benign string scored ' + noul).to.be.below(0.3);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
