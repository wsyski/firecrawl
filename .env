# ==============================================================================
# Firecrawl - local Docker Compose stack. Copy to .env in this directory:
#
#     cp .env.example .env
#
# .env is gitignored and holds the credentials. Everything that is NOT a
# credential is recorded here as this deployment actually runs it, including the
# LAN address and every threshold - so the template documents the real setup.
# Only *_API_KEY / *_AUTH_KEY / secret / token / password values are blanked.
#
# Everything here reaches the api container: docker-compose.yaml passes this
# whole file through with `env_file`, and separately lists the variables that
# have defaults in its x-common-env block. A key present in neither place is
# silently ignored, which is how TYPESAFE_API_KEY and MAX_RAM once ended up
# unset inside the container while looking configured here.
#
# apps/api/.env.example documents the API on its own (npm start, no Compose);
# it is not a drop-in contract for this stack.
#
# Every key is defined exactly once below. In a .env the LAST assignment wins,
# so an accidental duplicate silently overrides the value above it.
# ==============================================================================

# ===== Required ENVS ======
PORT=3002
HOST=0.0.0.0

# Note: PORT is used by both the main API server and worker liveness check endpoint

# To turn on DB authentication, you need to set up Supabase.
USE_DB_AUTHENTICATION=false

# Default is "debug", which is noisy (dumps full LLM extraction internals per request)
LOGGING_LEVEL=info

# ===== Optional ENVS ======

## === AI features (JSON format on scrape, /extract API) ===
# Provide your OpenAI API key here to enable AI features
MODEL_NAME=default

OPENAI_BASE_URL=http://192.168.1.100:8081/v1
OPENAI_API_KEY=
# (thinking template): stop the model from spending the whole
# completion budget on reasoning_content, which left `content` empty for
# extraction calls. Applied per-request in lib/local-model.ts (chat bodies only).
LLM_DISABLE_THINKING=false
TYPESAFE_BASE_URL=https://opencode.ai/zen
TYPESAFE_MODEL=jev-1.13
TYPESAFE_API_KEY=

## === Proxy ===
# PROXY_SERVER can be a full URL (e.g. http://0.1.2.3:1234) or just an IP and port combo (e.g. 0.1.2.3:1234)
# Do not uncomment PROXY_USERNAME and PROXY_PASSWORD if your proxy is unauthenticated
# PROXY_SERVER=
# PROXY_USERNAME=
# PROXY_PASSWORD=

## === /search API ===
# By default, the /search API will use Google search.

# You can specify a SearXNG server with the JSON format enabled, if you'd like to use that instead of direct Google.
# You can also customize the engines and categories parameters, but the defaults should also work just fine.
SEARXNG_ENDPOINT=http://192.168.1.100:3003
# Address SearXNG publishes on, for the api (SEARXNG_ENDPOINT above), host
# processes like Hermes, and other machines on the LAN. 127.0.0.1 keeps it private.
SEARXNG_BIND=192.168.1.100
# Which engines answer is decided in searxng/settings.yml. These narrow what
# Firecrawl asks for; recreate the api after a change
# (docker compose up -d --no-deps api).
# --sources web: engine and category pins, comma-separated; empty = instance default.
SEARXNG_ENGINES=
SEARXNG_CATEGORIES=
# --sources news: categories to query, e.g. news,science; empty = news.
SEARXNG_NEWS_CATEGORIES=news

## === Other ===

# Supabase Setup (used to support DB authentication, advanced logging, etc.)
# SUPABASE_ANON_TOKEN=
# SUPABASE_URL=
# SUPABASE_SERVICE_TOKEN=

# Use if you've set up authentication and want to test with a real API key
# TEST_API_KEY=

# This key lets you access the queue admin panel. Change this if your deployment is publicly accessible.
BULL_AUTH_KEY=

# This is now autoconfigured by the docker-compose.yaml. You shouldn't need to set it.
# PLAYWRIGHT_MICROSERVICE_URL=http://playwright-service:3000/scrape
# REDIS_URL=redis://redis:6379
# REDIS_RATE_LIMIT_URL=redis://redis:6379

## === PostgreSQL Database Configuration ===
# Configure PostgreSQL credentials. These should match the credentials used by the nuq-postgres container.
# If you change these, ensure all three are set consistently.
# POSTGRES_USER=firecrawl
# POSTGRES_PASSWORD=firecrawl_password
# POSTGRES_DB=firecrawl

# Set if you have a llamaparse key you'd like to use to parse pdfs
# LLAMAPARSE_API_KEY=

# Set if you'd like to send server health status messages to Slack
# SLACK_WEBHOOK_URL=

## === System Resource Configuration ===
# Worker admission control (services/system-monitor.ts). A worker only accepts a
# new job while cpuUsage < MAX_CPU && memoryUsage < MAX_RAM, measured HOST-wide.
# llama-swap holds ~33GB of model weights on this box, pushing the host to ~88%,
# which tripped the 0.8 default and stalled every worker -- LLM json extraction
# hung until timeout while plain scrape/search kept working.
MAX_RAM=0.95
MAX_CPU=0.95

# Set if you'd like to allow local webhooks to be sent to your self-hosted instance
# ALLOW_LOCAL_WEBHOOKS=true

LLM_SLOT_ID=1
LLM_LOCK_FILE=/llm-lock/llm.lock

## Reference: optional settings, showing the value used when unset

# ==============================================================================
## --- Search (SearXNG) ---
# Chain: fire-engine -> SearXNG -> DuckDuckGo (apps/api/src/search/v2/index.ts).
# # DuckDuckGo alone rate-limits to roughly 2 results in 8; with SearXNG, 8 in 8.
# # SEARXNG_* settings are set in the active section above.

# ==============================================================================
## --- Safe search + branding (Jev / TypeSafe) ---
# Jev is a System One decision model on POST {TYPESAFE_BASE_URL}/systemone,
# # not a chat model, so it goes through the TypeSafe SDK, not the OpenAI provider.
# #
# # TYPESAFE_BASE_URL is the API ROOT: the SDK appends /v1/systemone itself, so a
# # trailing /v1 requests /v1/v1/systemone and 404s.
# TYPESAFE_INPUT_USD_PER_MTOK=0.042
# BRANDING_JEV=true  # Jev's other consumer; off by default, safe:true does not need it
# BRANDING_JEV_ROLLOUT_PERCENT=0
# BRANDING_JEV_TIMEOUT_MS=5000

# ==============================================================================
## --- Worker admission control ---
# A worker takes a job only while cpuUsage < MAX_CPU && memoryUsage < MAX_RAM,
# # measured HOST-wide via systeminformation, not the container's cgroup limit.
# # A co-resident LLM server holding tens of GB of weights can push a shared host
# # past the 0.8 default and stall every worker.

# ==============================================================================
## --- Queue backend ---
# Unset = Postgres (nuq-postgres). "fdb" needs the FoundationDB services.
# NUQ_BACKEND=

# ==============================================================================
## --- Concurrency (Compose defaults in brackets) ---
# NUM_WORKERS_PER_QUEUE=8
# MAX_CONCURRENT_JOBS=5
# CRAWL_CONCURRENT_REQUESTS=10
# BROWSER_POOL_SIZE=5

# ==============================================================================
## --- Postgres (nuq-postgres) --- defaults point at the Compose service
# POSTGRES_HOST=nuq-postgres
# POSTGRES_PORT=5432
# POSTGRES_DB=postgres
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres

# ==============================================================================
## --- Redis (both unpublished on the host) ---
# REDIS_URL=redis://redis:6379
# REDIS_RATE_LIMIT_URL=redis://redis:6379

# ==============================================================================
## --- Local LLM (llama-swap / llama.cpp) ---
# "default" is a llama-swap `warm` selector: it serves whatever model is already
# # loaded and only loads its first target when none is. See the README's
# # "Resident model" section. Must be reachable FROM the containers, so the server
# # has to listen on all interfaces - localhost-only will not do.
# MODEL_EMBEDDING_NAME=  # unset unless you enable a vector feature
# OLLAMA_BASE_URL=

# ==============================================================================
## --- Proxy / egress ---
# PROXY_SERVER=
# PROXY_USERNAME=
# PROXY_PASSWORD=
